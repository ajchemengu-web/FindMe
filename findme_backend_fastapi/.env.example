# Copy to .env and fill in. Never commit the real .env file.

ENV=dev

# ---------- database ----------
# Local docker-compose default -- change the host if running Postgres elsewhere.
DATABASE_URL=postgresql+asyncpg://findme:findme@localhost:5432/findme

# ---------- auth ----------
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30

# ---------- Google sign-in ----------
# OAuth 2.0 Client ID (Web application type) from Google Cloud Console -> APIs &
# Services -> Credentials. Used to verify ID tokens from the Flutter app's
# google_sign_in flow. POST /auth/google 401s until this is set.
GOOGLE_CLIENT_ID=

# ---------- cron-gated ingestion endpoints (/ingest/*) ----------
# Required x-cron-secret header, same role as CRON_SHARED_SECRET in the old Supabase
# backend. Generate with: openssl rand -hex 32
CRON_SHARED_SECRET=

# Conflict/unrest/disaster event feed -- https://acleddata.com/data-export-tool/
ACLED_API_KEY=

# News headline feed -- a Guardian Open Platform key (free tier explicitly permits
# commercial/production use with attribution). Register at
# https://open-platform.theguardian.com/access/
NEWS_API_KEY=

# ---------- SMS / phone verification ----------
# "console" logs the OTP to the server log instead of sending a real SMS -- fine for
# local dev, not for production. Switch to "twilio" and fill in the three Twilio
# fields below once you have an account (or add another provider in app/services/sms.py).
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Publicly reachable base URL for the *frontend* (e.g. your Vercel domain) -- only
# used to build a sign-up link inside invite SMS text (POST /consents/invite). Fine to
# leave unset; the SMS just omits the link.
FRONTEND_URL=

# ---------- billing: M-Pesa (Daraja) ----------
# From your Daraja app (developer.safaricom.co.ke -> My Apps).
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox values are shared/public: shortcode 174379, passkey from
# developer.safaricom.co.ke/test_credentials. Production uses your own paybill/till
# shortcode + passkey after Safaricom's Go Live process.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# Must be a publicly reachable URL (Safaricom calls it directly) -- use ngrok or similar
# for local dev. Daraja posts to {PUBLIC_BASE_URL}/billing/mpesa/callback.
PUBLIC_BASE_URL=http://localhost:8000

# ---------- object storage (S3 / MinIO) ----------
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=findme
S3_SECRET_KEY=findme12345
S3_AVATARS_BUCKET=avatars
S3_INTEL_PHOTOS_BUCKET=intel-photos
S3_PUBLIC_BASE_URL=http://localhost:9000/avatars

# ---------- CORS ----------
# Comma-separated list, or leave as * for local dev.
CORS_ORIGINS=*
